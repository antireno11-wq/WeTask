DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public"
PRIMARY_ADMIN_EMAIL=""
PRIMARY_ADMIN_PASSWORD=""
PRIMARY_ADMIN_FULL_NAME="Administrador principal WeTask"
NEXT_PUBLIC_APP_URL="https://your-app.railway.app"
APP_URL="https://wetask.cl"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
SESSION_SECRET="change-this-secret-minimum-16-chars"
# Google OAuth (login con Google). Si no se setea, /api/auth/oauth devuelve 503.
GOOGLE_OAUTH_CLIENT_ID=""
# Solo dev: poner "true" para que ensureMarketplaceDemoData() siembre cuentas demo en cada login/catalog request.
SEED_DEMO_DATA="false"
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="WeTask <noreply@tudominio.cl>"
ADMIN_ONBOARDING_ALERT_EMAILS="antireno11@gmail.com"
# Destinatario de /api/support/contact. SUPPORT_EMAIL tiene prioridad; si
# falta cae a CONTACT_EMAIL y luego a ADMIN_ONBOARDING_ALERT_EMAILS.
SUPPORT_EMAIL=""
CONTACT_EMAIL=""
# Solo dev/CI: "true" habilita auth por headers x-user-id/x-user-role.
# NUNCA setear en producción — en prod getRequestIdentity la ignora igual.
ALLOW_HEADER_AUTH=""
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Secret de firma del webhook MercadoPago (panel MP > Webhooks > Secret).
# Obligatorio en producción: si falta, /api/payments/webhook/mercadopago
# devuelve 401 y MP reintenta.
MERCADOPAGO_WEBHOOK_SECRET=""
# MercadoPago Marketplace OAuth (Fase 5): el tasker conecta su propia
# cuenta MP para recibir pagos vía escrow nativo. Crear app en
# https://www.mercadopago.cl/developers/panel/app y agregar
# https://<dominio>/api/payments/mp/oauth/callback como Redirect URI.
MERCADOPAGO_APP_ID=""
MERCADOPAGO_APP_SECRET=""
# Opcional: override del redirect URI. Si está vacío se deriva de NEXT_PUBLIC_APP_URL.
MERCADOPAGO_OAUTH_REDIRECT_URI=""
# QStash (Upstash) — para crones automáticos de payout + reconciliación.
# Sacar del dashboard de Upstash: https://console.upstash.com/qstash
# QSTASH_CURRENT_SIGNING_KEY es obligatoria en producción para que los
# endpoints /api/cron/* acepten la llamada. QSTASH_NEXT_SIGNING_KEY es
# opcional (rotación). En dev podés dejar ambas vacías para llamar a mano.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_FROM_NUMBER="+15005550006"
TWILIO_MESSAGING_SERVICE_SID=""
SMS_CODE_PREVIEW="0"
# Cloudflare R2 / S3-compatible storage para documentos del onboarding.
# Si está sin configurar, el wizard cae al fallback de data:URL base64 (legacy).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET="wetask-docs"
# Upstash Redis para rate limiting (login, OAuth, password reset, OTP SMS,
# refund admin, leads, support, coverage). Sin envs el rate-limit es no-op
# (fail-open) — ideal para dev local, obligatorio en producción.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Pino logger level. Default: "info" en prod, "debug" en dev.
LOG_LEVEL=""
# Sentry — observabilidad de errores en producción. Sin DSN, next.config
# no envuelve con withSentryConfig y sentry.*.config.ts no inicializan.
# Org y project solo se usan para source-map upload en build de Vercel/Railway.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# OpenFactura (Haulmer) — boleta electrónica DTE 39, requisito SII Chile.
# Sin envs configuradas, /api/bookings/checkout sigue funcionando pero marca
# Payment.boletaStatus="SKIPPED" para que admin pueda reintentar después.
# Docs: https://docs.openfactura.cl/reference/dte-emitidos
OPENFACTURA_API_KEY=""
OPENFACTURA_RUT_EMISOR=""
OPENFACTURA_AMBIENTE="certificacion"
OPENFACTURA_BASE_URL=""
# Playwright E2E — cuentas demo para correr tests autenticados en CI.
# Setear en GitHub Secrets (Settings > Secrets > Actions).
PLAYWRIGHT_BASE_URL="http://localhost:3000"
E2E_CUSTOMER_EMAIL=""
E2E_CUSTOMER_PASS=""
E2E_PRO_EMAIL=""
E2E_PRO_PASS=""
